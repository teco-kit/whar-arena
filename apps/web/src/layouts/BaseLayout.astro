---
const { title = "HARena" } = Astro.props;
const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const basePathNoSlash = basePath.replace(/\/$/, "");
const withBase = (path: string) => `${basePath}${path.replace(/^\//, "")}`;
const normalizePath = (path: string) => {
  const normalized = path.replace(/\/$/, "") || "/";

  if (
    basePathNoSlash &&
    basePathNoSlash !== "/" &&
    (normalized === basePathNoSlash || normalized.startsWith(`${basePathNoSlash}/`))
  ) {
    return normalized.slice(basePathNoSlash.length).replace(/\/$/, "") || "/";
  }

  return normalized;
};
const activePath = normalizePath(Astro.url.pathname);
const tabListInitialStyle =
  "display:inline-flex;justify-self:center;gap:8px;padding:0;border:0;background:transparent;box-shadow:none;";
const tabInitialStyle =
  "position:relative;display:inline-flex;min-height:40px;align-items:center;justify-content:center;border:1px solid transparent;border-radius:999px;background:transparent;box-shadow:none;padding:0 14px;font-size:0.88rem;font-weight:600;line-height:1;text-decoration:none;";
const tabs = [
  {
    href: withBase("/leadboard"),
    label: "Leaderboard",
    matches: ["/", "/leadboard", "/leaderboard"],
  },
  {
    href: withBase("/models"),
    label: "Models",
    matches: ["/models"],
  },
  {
    href: withBase("/datasets"),
    label: "Datasets",
    matches: ["/datasets"],
  },
  {
    href: withBase("/contribute"),
    label: "Contribute",
    matches: ["/contribute"],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Protocol-driven benchmark for wearable human activity recognition." />
    <link rel="icon" type="image/png" sizes="512x512" href={withBase("/favicon.png")} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase("/apple-touch-icon.png")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-nav">
      <nav aria-label="Primary">
        <a class="brand" href={withBase("/leadboard")}>
          <img
            class="brand-icon"
            src={withBase("/whar-arena-icon.png")}
            width="64"
            height="36"
            alt=""
            aria-hidden="true"
          />
          <span>HARena</span>
        </a>
        <div
          class="site-tabs"
          role="tablist"
          aria-label="HARena sections"
          style={tabListInitialStyle}
        >
          {
            tabs.map((tab) => {
              const isActive = tab.matches.includes(activePath);
              const tabColor = isActive ? "var(--ink)" : "var(--muted-strong)";
              return (
                <a
                  class:list={["site-tab", { "is-active": isActive }]}
                  href={tab.href}
                  role="tab"
                  aria-selected={isActive ? "true" : "false"}
                  aria-current={isActive ? "page" : undefined}
                  style={`${tabInitialStyle}color:${tabColor};`}
                >
                  {tab.label}
                </a>
              );
            })
          }
        </div>
      </nav>
    </header>
    <slot />
    <footer class="review-notice">Anonymous submission for double-blind review.</footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: hsl(36 45% 98%);
    --panel: hsl(0 0% 100%);
    --panel-strong: hsl(33 31% 94%);
    --panel-soft: hsl(33 60% 96%);
    --ink: hsl(24 6% 17%);
    --muted: hsl(35 6% 38%);
    --muted-strong: hsl(30 7% 24%);
    --line: hsl(30 5% 93%);
    --line-strong: hsl(33 9% 83%);
    --accent: var(--ink);
    --accent-strong: var(--ink);
    --positive: hsl(125 49% 43%);
    --warning: hsl(48 93% 45%);
    --danger: hsl(2 63% 54%);
    --gold: hsl(39 72% 54%);
    --display-serif: Georgia, "Times New Roman", ui-serif, serif;
    font-family:
      "baselGrotesk", "Inter", ui-sans-serif, system-ui, -apple-system,
      BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-width: 320px;
    background: linear-gradient(180deg, var(--bg), var(--panel-soft) 64%);
    color: var(--ink);
    font-size: 15px;
    line-height: 1.5;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }

  .site-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--line-strong);
    background: hsl(0 0% 100% / 0.94);
    box-shadow: 0 4px 18px hsl(24 6% 17% / 0.06);
    backdrop-filter: blur(18px);
  }

  .site-nav nav {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: 14px;
    align-items: center;
    width: min(1440px, calc(100vw - 24px));
    min-height: 74px;
    margin: 0 auto;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: 13px;
    color: var(--ink);
    font-family: "Montserrat", "baselGrotesk", "Inter", ui-sans-serif, system-ui, sans-serif;
    font-size: 1.38rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1;
    text-decoration: none;
  }

  .brand:hover,
  .brand:focus-visible {
    opacity: 0.74;
    outline: none;
  }

  .brand-icon {
    display: block;
    flex: 0 0 auto;
    width: 64px;
    height: auto;
  }

  .site-tabs {
    display: inline-flex;
    justify-self: center;
    gap: 8px;
  }

  .site-tab {
    position: relative;
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    justify-content: center;
    color: var(--muted-strong);
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 0 14px;
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
  }

  .site-tab:hover,
  .site-tab:focus-visible {
    border-color: var(--line-strong) !important;
    background: var(--panel-soft) !important;
    color: var(--ink) !important;
    outline: none;
  }

  .site-tab.is-active {
    border-color: var(--line-strong) !important;
    background: var(--panel-soft) !important;
    color: var(--ink) !important;
    box-shadow: 0 1px 3px hsl(24 6% 17% / 0.06) !important;
  }

  .review-notice {
    width: min(1440px, calc(100vw - 24px));
    margin: 24px auto 48px;
    color: var(--muted);
    text-align: center;
    font-size: 0.84rem;
  }

  @media (max-width: 720px) {
    .site-nav nav {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
      row-gap: 10px;
      padding: 10px 0;
    }

    .brand {
      gap: 10px;
      font-size: 1.16rem;
    }

    .brand-icon {
      width: 52px;
    }

    .site-tabs {
      grid-column: 1 / -1;
      grid-row: 2;
      width: 100%;
      gap: 6px;
      justify-content: flex-start;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .site-tabs::-webkit-scrollbar {
      display: none;
    }

    .site-tab {
      flex: 0 0 auto;
      min-height: 38px;
      padding: 0 12px;
      font-size: 0.82rem;
    }
  }

  button,
  input,
  select {
    font: inherit;
  }

  a {
    color: inherit;
  }

  ::selection {
    background: hsl(24 6% 17% / 0.16);
  }
</style>
