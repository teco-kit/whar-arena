---
import {
  getEntityMarker,
  getMarkerPath,
  type MarkerPalette,
} from "../lib/entityMarkers";

interface Props {
  id: string;
  markerIndex?: number;
  palette?: MarkerPalette;
  size?: number;
}

const { id, markerIndex, palette = "model", size = 15 } = Astro.props;
const marker = getEntityMarker(id, markerIndex, palette);
---

<svg
  class="entity-marker"
  width={size}
  height={size}
  viewBox="-10 -10 20 20"
  aria-hidden="true"
  focusable="false"
>
  <path d={getMarkerPath(marker.shape)} fill={marker.color} fill-rule="evenodd"></path>
</svg>

<style>
  .entity-marker {
    display: block;
    flex: 0 0 auto;
    overflow: visible;
    stroke: var(--panel);
    stroke-width: 1.25;
  }
</style>
