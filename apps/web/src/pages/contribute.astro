---
import BenchmarkPage from "../components/BenchmarkPage.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const modelRepository = "https://github.com/teco-kit/whar-models";
const datasetRepository = "https://github.com/teco-kit/whar-datasets";
---

<BaseLayout title="HARena | Contribute">
  <BenchmarkPage
    title="Contribute"
    headingId="contribute-heading"
    description="Contribute code and metadata through one pull request to the model or dataset library. HARena discovers accepted contributions and benchmarks them using the official protocol."
  >
    <section class="start-panel" aria-labelledby="start-heading">
      <div class="section-heading">
        <p class="step-label">Step 1</p>
        <h2 id="start-heading">Choose what you are adding</h2>
        <p>Select a contribution type to see the exact repository, files and checks involved.</p>
      </div>

      <div class="type-switch" aria-label="Contribution type">
        <button type="button" class="is-active" data-kind-button="model" aria-pressed="true">
          <span class="type-icon" aria-hidden="true">M</span>
          <span>
            <strong>Add a model</strong>
            <small>Implement an architecture in whar-models</small>
          </span>
        </button>
        <button type="button" data-kind-button="dataset" aria-pressed="false">
          <span class="type-icon" aria-hidden="true">D</span>
          <span>
            <strong>Add a dataset</strong>
            <small>Add downloading, parsing and configuration in whar-datasets</small>
          </span>
        </button>
      </div>
    </section>

    <section class="path-panel" aria-labelledby="path-heading">
      <div data-path="model">
        <div class="path-intro">
          <div>
            <p class="step-label">Step 2</p>
            <h2 id="path-heading">Implement the model in <code>whar-models</code></h2>
            <p>
              The pull request itself is the submission. You do not add results or change the HARena
              repository.
            </p>
          </div>
          <a class="repo-button" href={modelRepository} target="_blank" rel="noreferrer">
            Open whar-models
          </a>
        </div>

        <ol class="code-steps">
          <li>
            <span class="step-number">1</span>
            <div>
              <h3>Add the implementation</h3>
              <p>
                Create <code>src/whar_models/&lt;model_id&gt;/model.py</code> and
                <code>__init__.py</code>. Export a builder that accepts
                <code>input_channels</code>, <code>window_length</code> and
                <code>num_classes</code> as keyword arguments.
              </p>
            </div>
          </li>
          <li>
            <span class="step-number">2</span>
            <div>
              <h3>Register the model and its metadata</h3>
              <p>
                Add an entry to <code>WHARModelID</code> and a matching
                <code>ModelSpec</code> in <code>src/whar_models/registry.py</code>. The registry stores
                the ID, display name, family, framework, paper title and builder.
              </p>
            </div>
          </li>
          <li>
            <span class="step-number">3</span>
            <div>
              <h3>Test and open the pull request</h3>
              <p>
                Add a focused build and forward-pass test using a generic input shaped
                <code>(batch, channels, timesteps)</code>. Models must support different channel,
                window and class counts.
              </p>
              <div class="command-row">
                <code>uv sync --extra dev</code>
                <code>uv run pytest</code>
              </div>
            </div>
          </li>
        </ol>

        <div class="acceptance-note">
          <strong>After merge</strong>
          <span>
            <code>whar_models.list_models()</code> exposes the model. HARena can then plan it against
            every official dataset; maintainers produce and validate the benchmark results.
          </span>
        </div>
      </div>

      <div data-path="dataset" hidden>
        <div class="path-intro">
          <div>
            <p class="step-label">Step 2</p>
            <h2>Implement the dataset in <code>whar-datasets</code></h2>
            <p>
              The pull request adds an adapter for the original source. Raw dataset files must not be
              committed to the repository.
            </p>
          </div>
          <a class="repo-button" href={datasetRepository} target="_blank" rel="noreferrer">
            Open whar-datasets
          </a>
        </div>

        <ol class="code-steps">
          <li>
            <span class="step-number">1</span>
            <div>
              <h3>Add a parser and configuration</h3>
              <p>
                Create <code>src/whar_datasets/config/cfg_&lt;dataset_id&gt;.py</code>. Its parser returns
                activity metadata, session metadata and standardized sensor sessions; its
                <code>WHARConfig</code> declares source URLs, sampling, counts, activities and channels.
              </p>
            </div>
          </li>
          <li>
            <span class="step-number">2</span>
            <div>
              <h3>Register the dataset</h3>
              <p>
                Add the ID to <code>WHARDatasetID</code> in
                <code>src/whar_datasets/config/getter.py</code>. Standard names
                <code>cfg_&lt;dataset_id&gt;.py</code> and <code>cfg_&lt;dataset_id&gt;</code> are discovered
                automatically. Add it to <code>BENCHMARK_DATASET_IDS</code> only when requesting
                official benchmark inclusion.
              </p>
            </div>
          </li>
          <li>
            <span class="step-number">3</span>
            <div>
              <h3>Test and open the pull request</h3>
              <p>
                Add focused parser tests using small synthetic fixtures. Verify subject, activity,
                timestamp and channel semantics without committing the raw dataset.
              </p>
              <div class="command-row">
                <code>uv sync --extra dev</code>
                <code>uv run pytest</code>
              </div>
            </div>
          </li>
        </ol>

        <div class="acceptance-note">
          <strong>After merge</strong>
          <span>
            Maintainers separately review benchmark eligibility. Once the dataset is in
            <code>BENCHMARK_DATASET_IDS</code>, HARena can plan every registered model against it.
          </span>
        </div>
      </div>
    </section>

    <section class="brief-panel" aria-labelledby="brief-heading">
      <div class="section-heading brief-heading">
        <div>
          <p class="step-label">Step 3</p>
          <h2 id="brief-heading">Prepare the pull-request description</h2>
          <p>
            This optional helper turns your metadata into Markdown for the PR. It does not upload,
            save or submit anything.
          </p>
        </div>
      </div>

      <form data-contribution-form="model">
        <div class="metadata-layout model-metadata-layout">
          <fieldset class="metadata-section">
            <legend>
              <span>Identity and publication</span>
              <small>Stable registry names and the scientific source represented by this implementation.</small>
            </legend>
            <div class="field-grid">
              <label>
                <span>Model ID *</span>
                <input name="id" required pattern="[a-z0-9]+(?:_[a-z0-9]+)*" placeholder="tinyhar" />
                <small>Lowercase snake_case, matching <code>WHARModelID</code>.</small>
              </label>
              <label>
                <span>Display name *</span>
                <input name="name" required placeholder="TinyHAR" />
              </label>
              <label class="wide-field">
                <span>Paper title *</span>
                <input name="paper_title" required placeholder="Full publication title" />
                <small>The model registry requires paper metadata.</small>
              </label>
              <label>
                <span>Paper URL</span>
                <input name="paper_url" type="url" placeholder="https://doi.org/..." />
              </label>
              <label>
                <span>Publication year</span>
                <input name="year" type="number" min="1900" max="2100" placeholder="2026" />
              </label>
              <label class="wide-field">
                <span>Authors</span>
                <input name="authors" placeholder="First Author, Second Author" />
              </label>
            </div>
          </fieldset>

          <fieldset class="metadata-section">
            <legend>
              <span>Architecture and implementation</span>
              <small>How the implementation is classified and licensed.</small>
            </legend>
            <div class="field-grid">
              <div class="architecture-picker wide-field" aria-labelledby="architecture-picker-label">
                <div class="field-label-row">
                  <span id="architecture-picker-label">Architecture components *</span>
                  <small>Select all that apply.</small>
                </div>
                <div class="architecture-options" data-architecture-options>
                  <label><input type="checkbox" name="architecture_parts" value="attention" /><span>Attention</span></label>
                  <label><input type="checkbox" name="architecture_parts" value="cnn" /><span>Convolutional</span></label>
                  <label><input type="checkbox" name="architecture_parts" value="dense" /><span>Dense</span></label>
                  <label><input type="checkbox" name="architecture_parts" value="features" /><span>Handcrafted</span></label>
                  <label><input type="checkbox" name="architecture_parts" value="graph" /><span>Graph</span></label>
                  <label><input type="checkbox" name="architecture_parts" value="rnn" /><span>Recurrent</span></label>
                  <label><input type="checkbox" name="architecture_parts" value="spectral" /><span>Spectral</span></label>
                </div>
                <div class="custom-architecture-row">
                  <input
                    type="text"
                    data-custom-architecture
                    aria-label="Custom architecture component"
                    placeholder="Add another component"
                  />
                  <button type="button" data-add-architecture>Add component</button>
                </div>
                <small class="field-help">
                  Multiple selections are combined into the proposed registry family; custom components
                  appear as additional selected options.
                </small>
              </div>
              <label>
                <span>Framework *</span>
                <select name="framework" required>
                  <option value="">Select a framework</option>
                  <option value="torch">PyTorch</option>
                  <option value="sklearn">scikit-learn</option>
                  <option value="tensorflow">TensorFlow</option>
                  <option value="other">Other</option>
                </select>
              </label>
              <label>
                <span>Implementation license</span>
                <input name="license" placeholder="Apache-2.0" />
              </label>
              <label>
                <span>Original implementation URL</span>
                <input name="source_url" type="url" placeholder="https://github.com/..." />
              </label>
            </div>
          </fieldset>

          <fieldset class="metadata-section">
            <legend>
              <span>Reproducibility notes</span>
              <small>Defaults, deviations and constraints reviewers should know about.</small>
            </legend>
            <div class="field-grid">
              <label class="wide-field">
                <span>Defaults and implementation notes</span>
                <textarea name="notes" rows="4" placeholder="Default hyperparameters, implementation differences or special constraints"></textarea>
              </label>
            </div>
          </fieldset>
        </div>

        <div class="form-footer">
          <p><strong>*</strong> Required for a complete PR description.</p>
          <button class="prepare-button" type="submit">Prepare model PR description</button>
        </div>
      </form>

      <form data-contribution-form="dataset" hidden>
        <div class="metadata-layout dataset-metadata-layout">
          <fieldset class="metadata-section">
            <legend>
              <span>Identity and publication</span>
              <small>Stable registry names and the scientific source that introduced the dataset.</small>
            </legend>
            <div class="field-grid">
              <label>
                <span>Dataset ID *</span>
                <input name="id" required pattern="[a-z0-9]+(?:_[a-z0-9]+)*" placeholder="example_har" />
                <small>Lowercase snake_case, matching <code>WHARDatasetID</code>.</small>
              </label>
              <label>
                <span>Display name *</span>
                <input name="name" required placeholder="Example-HAR" />
              </label>
              <label>
                <span>Paper URL</span>
                <input name="paper_url" type="url" placeholder="https://doi.org/..." />
              </label>
              <label>
                <span>Publication year</span>
                <input name="year" type="number" min="1900" max="2100" placeholder="2026" />
              </label>
              <label class="wide-field">
                <span>Authors</span>
                <input name="authors" placeholder="First Author, Second Author" />
              </label>
            </div>
          </fieldset>

          <fieldset class="metadata-section">
            <legend>
              <span>Dataset structure and sampling</span>
              <small>Scale, labels, channels and timing exposed by <code>WHARConfig</code>.</small>
            </legend>
            <div class="field-grid three-column-grid">
              <label>
                <span>Subjects</span>
                <input name="subjects" type="number" min="1" placeholder="30" />
              </label>
              <label>
                <span>Activities</span>
                <input name="activities" type="number" min="1" placeholder="12" />
              </label>
              <label>
                <span>Sensor channels</span>
                <input name="channels" type="number" min="1" placeholder="6" />
              </label>
            </div>
            <div class="field-grid dataset-detail-grid">
              <label>
                <span>Available activities</span>
                <input name="activity_names" placeholder="walking, running, sitting" />
                <small>Comma-separated canonical activity names.</small>
              </label>
              <label>
                <span>Available sensor channels</span>
                <input name="channel_names" placeholder="wrist_acc_x, wrist_acc_y, wrist_acc_z" />
                <small>Comma-separated channel names.</small>
              </label>
              <label>
                <span>Source rate mode</span>
                <select name="source_rate_mode">
                  <option value="fixed">Fixed sampling rate</option>
                  <option value="per_session">Varies by session</option>
                </select>
              </label>
              <label>
                <span>Sampling frequency</span>
                <input name="sampling_freq" placeholder="50 Hz" />
              </label>
            </div>
          </fieldset>

          <fieldset class="metadata-section">
            <legend>
              <span>Source, access and limitations</span>
              <small>Where the data comes from, how it may be used and constraints reviewers should know.</small>
            </legend>
            <div class="field-grid">
              <label>
                <span>Official dataset page *</span>
                <input name="dataset_url" type="url" required placeholder="https://zenodo.org/..." />
              </label>
              <label>
                <span>Download URL or access instructions *</span>
                <input name="download_url" required placeholder="https://... or registration required" />
              </label>
              <label class="wide-field">
                <span>License or access terms *</span>
                <input name="license" required placeholder="CC BY 4.0 or research access agreement" />
              </label>
              <label class="wide-field">
                <span>Devices, placements and limitations</span>
                <textarea name="notes" rows="4" placeholder="Devices, body positions, missing values, access constraints or known quality issues"></textarea>
              </label>
            </div>
          </fieldset>
        </div>

        <div class="form-footer dataset-form-footer">
          <label class="eligibility-check">
            <input name="benchmark_eligible" type="checkbox" value="true" />
            <span>Ask maintainers to review this dataset for <code>BENCHMARK_DATASET_IDS</code>.</span>
          </label>
          <button class="prepare-button" type="submit">Prepare dataset PR description</button>
        </div>
      </form>
    </section>

    <section class="output-panel" data-output-panel hidden aria-labelledby="output-heading">
      <div class="output-heading">
        <div>
          <p class="step-label">Ready to use</p>
          <h2 id="output-heading">Pull-request description</h2>
        </div>
        <span data-output-status>Prepared</span>
      </div>
      <p>
        Copy this Markdown into your PR description. If you want early feedback before implementing,
        open the same content as a GitHub issue instead.
      </p>
      <pre><code data-markdown-output></code></pre>
      <div class="output-actions">
        <button type="button" data-copy-markdown>Copy PR description</button>
        <a data-open-repository target="_blank" rel="noreferrer">Open repository</a>
        <a data-open-issue target="_blank" rel="noreferrer">Ask for feedback first</a>
        <a class="primary-action" data-open-pr target="_blank" rel="noreferrer">Open pull request</a>
      </div>
      <p class="pr-note">
        Your implementation must already be pushed to a branch before GitHub can open its pull
        request. HARena never receives the form data directly.
      </p>
    </section>
  </BenchmarkPage>
</BaseLayout>

<script>
  type ContributionKind = "model" | "dataset";

  const repositories: Record<ContributionKind, string> = {
    model: "https://github.com/teco-kit/whar-models",
    dataset: "https://github.com/teco-kit/whar-datasets",
  };

  let currentMarkdown = "";

  const kindButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-kind-button]"));
  const paths = Array.from(document.querySelectorAll<HTMLElement>("[data-path]"));
  const forms = Array.from(
    document.querySelectorAll<HTMLFormElement>("[data-contribution-form]"),
  );
  const outputPanel = document.querySelector<HTMLElement>("[data-output-panel]");
  const markdownOutput = document.querySelector<HTMLElement>("[data-markdown-output]");
  const outputStatus = document.querySelector<HTMLElement>("[data-output-status]");
  const repositoryLink = document.querySelector<HTMLAnchorElement>("[data-open-repository]");
  const issueLink = document.querySelector<HTMLAnchorElement>("[data-open-issue]");
  const pullRequestLink = document.querySelector<HTMLAnchorElement>("[data-open-pr]");
  const architectureOptions = document.querySelector<HTMLElement>("[data-architecture-options]");
  const customArchitectureInput = document.querySelector<HTMLInputElement>("[data-custom-architecture]");
  const addArchitectureButton = document.querySelector<HTMLButtonElement>("[data-add-architecture]");

  const value = (data: FormData, key: string) => String(data.get(key) ?? "").trim();
  const row = (label: string, fieldValue: string) =>
    fieldValue ? `| ${label} | ${fieldValue.replaceAll("|", "\\|").replaceAll("\n", " ")} |` : null;
  const slugify = (text: string) =>
    text.toLowerCase().trim().replace(/[^a-z0-9]+/g, "_").replace(/^_+|_+$/g, "");

  const addCustomArchitecture = () => {
    const labelText = customArchitectureInput?.value.trim() ?? "";
    if (!labelText || !architectureOptions || !customArchitectureInput) return;

    const existing = Array.from(
      architectureOptions.querySelectorAll<HTMLInputElement>('input[name="architecture_parts"]'),
    ).find((input) => input.value.toLowerCase() === labelText.toLowerCase());

    if (existing) {
      existing.checked = true;
    } else {
      const label = document.createElement("label");
      label.className = "is-custom";
      const input = document.createElement("input");
      input.type = "checkbox";
      input.name = "architecture_parts";
      input.value = labelText;
      input.checked = true;
      const text = document.createElement("span");
      text.textContent = labelText;
      label.append(input, text);
      architectureOptions.append(label);
    }

    customArchitectureInput.value = "";
    customArchitectureInput.setCustomValidity("");
  };

  addArchitectureButton?.addEventListener("click", addCustomArchitecture);
  customArchitectureInput?.addEventListener("keydown", (event) => {
    if (event.key === "Enter") {
      event.preventDefault();
      addCustomArchitecture();
    }
  });
  architectureOptions?.addEventListener("change", () => customArchitectureInput?.setCustomValidity(""));

  const makeDescription = (kind: ContributionKind, data: FormData) => {
    const rows = [
      row(kind === "model" ? "Model ID" : "Dataset ID", `\`${value(data, "id")}\``),
      row("Name", value(data, "name")),
    ];

    if (kind === "model") {
      const components = data.getAll("architecture_parts").map(String);
      rows.push(
        row("Architecture components", components.join(", ")),
        row("Proposed registry family", components.map(slugify).filter(Boolean).join("_")),
        row("Framework", value(data, "framework")),
        row("Paper", value(data, "paper_title")),
        row("Paper URL", value(data, "paper_url")),
        row("Publication year", value(data, "year")),
        row("Original implementation", value(data, "source_url")),
        row("License", value(data, "license")),
        row("Authors", value(data, "authors")),
        row("Notes", value(data, "notes")),
      );
    } else {
      rows.push(
        row("Dataset page", value(data, "dataset_url")),
        row("Download/access", value(data, "download_url")),
        row("License/access terms", value(data, "license")),
        row("Paper URL", value(data, "paper_url")),
        row("Publication year", value(data, "year")),
        row("Authors", value(data, "authors")),
        row("Source-rate mode", value(data, "source_rate_mode")),
        row("Sampling frequency", value(data, "sampling_freq")),
        row("Subjects", value(data, "subjects")),
        row("Activities", value(data, "activities")),
        row("Channels", value(data, "channels")),
        row("Activity names", value(data, "activity_names")),
        row("Channel names", value(data, "channel_names")),
        row("Notes", value(data, "notes")),
        row(
          "Official benchmark review",
          data.get("benchmark_eligible") === "true" ? "Requested" : "Not requested",
        ),
      );
    }

    const checklist = kind === "model"
      ? [
          "- [ ] Implementation package and builder added",
          "- [ ] `WHARModelID` and `ModelSpec` registered",
          "- [ ] Generic build and forward-pass test added",
          "- [ ] `uv run pytest` passes",
        ]
      : [
          "- [ ] Parser and `WHARConfig` added",
          "- [ ] `WHARDatasetID` registered",
          "- [ ] Focused parser tests added without raw data",
          "- [ ] `uv run pytest` passes",
        ];

    return [
      `## ${kind === "model" ? "Model" : "Dataset"} summary`,
      "",
      "| Field | Value |",
      "| --- | --- |",
      ...rows.filter((item): item is string => item !== null),
      "",
      "## Implementation checklist",
      "",
      ...checklist,
    ].join("\n");
  };

  const setActiveKind = (kind: ContributionKind) => {
    kindButtons.forEach((button) => {
      const isActive = button.dataset.kindButton === kind;
      button.classList.toggle("is-active", isActive);
      button.setAttribute("aria-pressed", String(isActive));
    });
    paths.forEach((path) => (path.hidden = path.dataset.path !== kind));
    forms.forEach((form) => (form.hidden = form.dataset.contributionForm !== kind));
    if (outputPanel) outputPanel.hidden = true;
  };

  kindButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const kind = button.dataset.kindButton;
      if (kind === "model" || kind === "dataset") setActiveKind(kind);
    });
  });

  forms.forEach((form) => {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const kind = form.dataset.contributionForm as ContributionKind;
      if (kind === "model") {
        addCustomArchitecture();
        const selectedComponents = form.querySelectorAll<HTMLInputElement>(
          'input[name="architecture_parts"]:checked',
        );
        if (selectedComponents.length === 0 && customArchitectureInput) {
          customArchitectureInput.setCustomValidity("Select or add at least one architecture component.");
          customArchitectureInput.reportValidity();
          return;
        }
      }
      if (!form.reportValidity()) return;

      const data = new FormData(form);
      const repository = repositories[kind];
      const displayName = value(data, "name") || value(data, "id");
      currentMarkdown = makeDescription(kind, data);

      if (markdownOutput) markdownOutput.textContent = currentMarkdown;
      if (outputStatus) {
        outputStatus.textContent = `${kind === "model" ? "Model" : "Dataset"} PR text ready`;
      }
      if (repositoryLink) repositoryLink.href = repository;
      if (issueLink) {
        const title = `[${kind} proposal] ${displayName}`;
        issueLink.href = `${repository}/issues/new?title=${encodeURIComponent(title)}&body=${encodeURIComponent(currentMarkdown)}`;
      }
      if (pullRequestLink) pullRequestLink.href = `${repository}/compare`;
      if (outputPanel) {
        outputPanel.hidden = false;
        outputPanel.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    });
  });

  document
    .querySelector<HTMLButtonElement>("[data-copy-markdown]")
    ?.addEventListener("click", async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      try {
        await navigator.clipboard.writeText(currentMarkdown);
        button.textContent = "Copied";
      } catch {
        if (markdownOutput) {
          const range = document.createRange();
          range.selectNodeContents(markdownOutput);
          const selection = window.getSelection();
          selection?.removeAllRanges();
          selection?.addRange(range);
        }
        button.textContent = "Selected";
      }
      window.setTimeout(() => (button.textContent = "Copy PR description"), 1600);
    });
</script>

<style>
  .start-panel, .path-panel, .brief-panel, .output-panel {
    margin-top: 14px; overflow: hidden; border: 1px solid lightgray;
    border-radius: 8px; background: var(--panel);
  }
  .section-heading, .path-intro, .output-heading { padding: 20px; }
  .section-heading h2, .path-intro h2, .output-heading h2 {
    margin: 2px 0 0; font-family: var(--display-serif); font-size: 1.35rem;
    font-weight: 500; line-height: 1.15;
  }
  .section-heading p:last-child, .path-intro p:last-child, .output-panel > p {
    max-width: 850px; margin: 8px 0 0; color: var(--muted-strong); font-size: 0.86rem;
