---
import BenchmarkPage from "../components/BenchmarkPage.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title="HARena | Contribute">
  <BenchmarkPage
    title="Contribute"
    headingId="contribute-heading"
    description="Contributions are paused during double-blind review."
  >
    <section class="review-panel">
      <h2>Review version</h2>
      <p>Repository links and submission forms are withheld during review.</p>
      <p>
        Explore the <a href={`${basePath}models`}>models</a>,
        <a href={`${basePath}datasets`}>datasets</a>, and
        <a href={`${basePath}leadboard`}>benchmark results</a>.
      </p>
    </section>
  </BenchmarkPage>
</BaseLayout>

<style>
  .review-panel {
    padding: 24px;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    background: var(--panel);
  }
</style>
