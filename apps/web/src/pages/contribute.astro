---
import BenchmarkPage from "../components/BenchmarkPage.astro";
import catalog from "../generated/catalog.json";
import BaseLayout from "../layouts/BaseLayout.astro";


const existingEntries = {
  model: catalog.models.map(({ id, name }) => ({ id, name })),
  dataset: catalog.datasets.map(({ id, name }) => ({ id, name })),
  pages: { model: "../models/", dataset: "../datasets/" },
};
---

<BaseLayout title="HARena | Contribute">
  <BenchmarkPage
    title="Contribute"
    headingId="contribute-heading"
    description="Propose a new model or dataset. Repository and submission links are withheld during double-blind review."
  >
    <script is:inline type="application/json" id="existing-entries" set:html={JSON.stringify(existingEntries)} />

    <section class="panel flow-panel" aria-labelledby="flow-heading">
      <div class="section-heading">
        <p class="step-label">How it works</p>
        <h2 id="flow-heading">From proposal to leaderboard</h2>
      </div>

      <ol class="flow-steps">
        <li class="is-current">
          <span class="step-number">1</span>
          <div>
            <span class="flow-where">On this page</span>
            <h3>Propose</h3>
            <p>Fill in the form below.</p>
          </div>
        </li>
        <li>
          <span class="step-number">2</span>
          <div>
            <span class="flow-where">GitHub issue</span>
            <h3>Discuss</h3>
            <p>Maintainers confirm scope and ID.</p>
          </div>
        </li>
        <li>
          <span class="step-number">3</span>
          <div>
            <span class="flow-where">Pull request</span>
            <h3>Implement</h3>
            <p>Anyone opens a pull request.</p>
          </div>
        </li>
        <li>
          <span class="step-number">4</span>
          <div>
            <span class="flow-where">After merge</span>
            <h3>Benchmark</h3>
            <p>Results appear on the leaderboard.</p>
          </div>
        </li>
      </ol>

      <p class="flow-shortcut">Already have code? Skip to the <a href="#implement">implementation guide</a>.</p>
    </section>

    <section class="panel proposal-panel" aria-labelledby="proposal-heading">
      <div class="section-heading">
        <p class="step-label">Step 1 · Propose</p>
        <h2 id="proposal-heading">Describe your proposal</h2>
      </div>

      <div class="question">
        <p class="question-label"><span class="question-number">A</span>What would you like to add?</p>
        <div class="choice-grid" role="group" aria-label="Contribution type">
          <button type="button" class="choice-card is-active" data-kind-button="model" aria-pressed="true">
            <span class="type-icon" aria-hidden="true">M</span>
            <span>
              <strong>A model</strong>
              <small>Added to <code>whar-models</code></small>
            </span>
          </button>
          <button type="button" class="choice-card" data-kind-button="dataset" aria-pressed="false">
            <span class="type-icon" aria-hidden="true">D</span>
            <span>
              <strong>A dataset</strong>
              <small>Added to <code>whar-datasets</code></small>
            </span>
          </button>
        </div>
      </div>

      <div class="question">
        <p class="question-label" id="intent-label"><span class="question-number">B</span>Who will implement it?</p>
        <div class="choice-grid" role="radiogroup" aria-labelledby="intent-label">
          <label class="choice-card intent-card">
            <input type="radio" name="intent" value="self" checked />
            <span class="radio-dot" aria-hidden="true"></span>
            <span>
              <strong>I'll implement it</strong>
              <small>You open the pull request</small>
            </span>
          </label>
          <label class="choice-card intent-card">
            <input type="radio" name="intent" value="request" />
            <span class="radio-dot" aria-hidden="true"></span>
            <span>
              <strong>I'm requesting it</strong>
              <small>Someone else may pick it up</small>
            </span>
          </label>
        </div>
      </div>

      <div class="question question-details">
        <p class="question-label"><span class="question-number">C</span>Tell us about it</p>

        <div class="proposal-layout">
          <div class="proposal-forms">
            <form data-contribution-form="model" id="model-form">
              <fieldset class="metadata-section">
                <legend>
                  <span>The model</span>
                </legend>
                <div class="field-grid">
                  <label class="field">
                    <span class="field-label">Model name <em class="req">required</em></span>
                    <input name="name" required placeholder="e.g. TinyHAR" autocomplete="off" data-name-input />
                  </label>
                  <label class="field">
                    <span class="field-label">Model ID</span>
                    <input name="id" pattern="[a-z0-9]+(?:_[a-z0-9]+)*" placeholder="tinyhar" autocomplete="off" data-id-input />
                  </label>
                  <p class="field-warning wide-field" data-duplicate-warning hidden></p>
                  <label class="field wide-field">
                    <span class="field-label">Paper title <em class="req">required</em></span>
                    <input name="paper_title" required placeholder="Full publication title" />
                  </label>
                  <label class="field">
                    <span class="field-label">Paper link</span>
                    <input name="paper_url" type="url" placeholder="https://doi.org/…" />
                  </label>
                  <label class="field">
                    <span class="field-label">Year</span>
                    <input name="year" type="number" min="1900" max="2100" placeholder="2022" />
                  </label>
                  <label class="field wide-field">
                    <span class="field-label">Authors</span>
                    <input name="authors" placeholder="First Author, Second Author" />
                  </label>
                </div>
              </fieldset>

              <fieldset class="metadata-section">
                <legend>
                  <span>Architecture</span>
                </legend>
                <div class="field-grid">
                  <div class="architecture-picker wide-field" role="group" aria-labelledby="architecture-picker-label">
                    <span class="field-label" id="architecture-picker-label">Building blocks <em class="req">required</em></span>
                    <div class="architecture-options" data-architecture-options>
                      <label><input type="checkbox" name="architecture_parts" value="Convolutional" /><span>Convolutional</span></label>
                      <label><input type="checkbox" name="architecture_parts" value="Recurrent" /><span>Recurrent</span></label>
                      <label><input type="checkbox" name="architecture_parts" value="Attention / Transformer" /><span>Attention / Transformer</span></label>
                      <label><input type="checkbox" name="architecture_parts" value="Fully connected" /><span>Fully connected</span></label>
                      <label><input type="checkbox" name="architecture_parts" value="Graph" /><span>Graph</span></label>
                      <label><input type="checkbox" name="architecture_parts" value="Spectral" /><span>Spectral</span></label>
                      <label><input type="checkbox" name="architecture_parts" value="Handcrafted features" /><span>Handcrafted features</span></label>
                    </div>
                    <div class="custom-architecture-row">
                      <input
                        type="text"
                        data-custom-architecture
                        aria-label="Other building block"
                        placeholder="Other…"
                      />
                      <button type="button" data-add-architecture>Add</button>
                    </div>
                  </div>
                  <label class="field">
                    <span class="field-label">Framework <em class="req">required</em></span>
                    <select name="framework" required>
                      <option value="torch">PyTorch</option>
                      <option value="sklearn">scikit-learn</option>
                      <option value="tensorflow">TensorFlow / Keras</option>
                      <option value="other">Other</option>
                    </select>
                  </label>
                </div>
              </fieldset>

              <fieldset class="metadata-section">
                <legend>
                  <span>Source code</span>
                </legend>
                <div class="field-grid">
                  <label class="field">
                    <span class="field-label">Original implementation</span>
                    <input name="source_url" type="url" placeholder="https://github.com/…" />
                  </label>
                  <label class="field">
                    <span class="field-label">License of that code</span>
                    <input name="license" placeholder="e.g. MIT, Apache-2.0" list="license-options" />
                  </label>
                  <label class="field wide-field">
                    <span class="field-label">Notes for reviewers</span>
                    <textarea name="notes" rows="3" placeholder="Optional"></textarea>
                  </label>
                </div>
              </fieldset>
            </form>

            <form data-contribution-form="dataset" id="dataset-form" hidden>
              <fieldset class="metadata-section">
                <legend>
                  <span>The dataset</span>
                </legend>
                <div class="field-grid">
                  <label class="field">
                    <span class="field-label">Dataset name <em class="req">required</em></span>
                    <input name="name" required placeholder="e.g. PAMAP2" autocomplete="off" data-name-input />
                  </label>
                  <label class="field">
                    <span class="field-label">Dataset ID</span>
                    <input name="id" pattern="[a-z0-9]+(?:_[a-z0-9]+)*" placeholder="pamap2" autocomplete="off" data-id-input />
                  </label>
                  <p class="field-warning wide-field" data-duplicate-warning hidden></p>
                  <label class="field">
                    <span class="field-label">Paper link</span>
                    <input name="paper_url" type="url" placeholder="https://doi.org/…" />
                  </label>
                  <label class="field">
                    <span class="field-label">Year</span>
                    <input name="year" type="number" min="1900" max="2100" placeholder="2012" />
                  </label>
                  <label class="field wide-field">
                    <span class="field-label">Authors</span>
                    <input name="authors" placeholder="First Author, Second Author" />
                  </label>
                </div>
              </fieldset>

              <fieldset class="metadata-section">
                <legend>
                  <span>Access</span>
                </legend>
                <div class="field-grid">
                  <label class="field">
                    <span class="field-label">Dataset page <em class="req">required</em></span>
                    <input name="dataset_url" type="url" required placeholder="https://zenodo.org/…" />
                  </label>
                  <label class="field">
                    <span class="field-label">How to get the data</span>
                    <input name="download_url" placeholder="Link or access steps" />
                  </label>
                  <label class="field wide-field">
                    <span class="field-label">License or access terms</span>
                    <input name="license" placeholder="e.g. CC BY 4.0" list="license-options" />
                  </label>
                </div>
              </fieldset>

              <fieldset class="metadata-section">
                <legend>
                  <span>Contents</span>
                </legend>
                <div class="field-grid three-column-grid">
                  <label class="field">
                    <span class="field-label">Subjects</span>
                    <input name="subjects" type="number" min="1" placeholder="9" />
                  </label>
                  <label class="field">
                    <span class="field-label">Activities</span>
                    <input name="activities" type="number" min="1" placeholder="18" />
                  </label>
                  <label class="field">
                    <span class="field-label">Sampling rate</span>
                    <span class="input-unit">
                      <input name="sampling_freq" type="number" min="0" step="any" placeholder="100" />
                      <span aria-hidden="true">Hz</span>
                    </span>
                  </label>
                </div>
                <div class="field-grid">
                  <label class="field wide-field">
                    <span class="field-label">Sensors and body positions</span>
                    <input name="sensors" placeholder="e.g. IMUs on wrist, chest and ankle" />
                  </label>
                  <label class="field wide-field">
                    <span class="field-label">Activity labels</span>
                    <input name="activity_names" placeholder="walking, running, sitting, …" />
                  </label>
                  <label class="field wide-field">
                    <span class="field-label">Notes for reviewers</span>
                    <textarea name="notes" rows="3" placeholder="Optional"></textarea>
                  </label>
                  <label class="check-field wide-field">
                    <input name="benchmark_eligible" type="checkbox" value="true" checked />
                    <span>Request inclusion in the official benchmark</span>
                  </label>
                </div>
              </fieldset>
            </form>

            <datalist id="license-options">
              <option value="MIT"></option>
              <option value="Apache-2.0"></option>
              <option value="BSD-3-Clause"></option>
              <option value="GPL-3.0"></option>
              <option value="CC BY 4.0"></option>
              <option value="CC BY-NC 4.0"></option>
              <option value="CC0 1.0"></option>
              <option value="Unknown"></option>
            </datalist>
          </div>

          <aside class="preview" aria-labelledby="preview-heading">
            <div class="preview-head">
              <h3 id="preview-heading">Issue preview</h3>
              <span class="repo-badge" data-preview-repo>[Model repository]</span>
            </div>
            <p class="preview-title" data-preview-title></p>
            <pre class="preview-body"><code data-preview-body></code></pre>
            <div class="preview-actions">
              <button type="button" class="primary-action" data-open-issue>
                Preview submission
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M18 14v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4" /></svg>
              </button>
              <button type="button" class="secondary-action" data-copy-markdown>Copy text</button>
            </div>
            <p class="preview-note" data-form-status aria-live="polite">Copy your proposal text. The issue link is withheld during review.</p>
            <button type="button" class="reset-link" data-reset-form>Clear form</button>
          </aside>
        </div>
      </div>
    </section>

    <section class="panel next-panel" data-next-panel hidden aria-labelledby="next-heading" tabindex="-1">
      <div class="section-heading">
        <p class="step-label">Step 2 · Discuss</p>
        <h2 id="next-heading">Submit the issue</h2>
        <p>The <span class="repository-placeholder" role="link" aria-disabled="true">[Issue submission link]</span> is withheld during double-blind review. You can copy the proposal text from the preview above.</p>
      </div>
      <ol class="next-steps" data-next-self>
        <li>Note the issue number, e.g. <code>#42</code>.</li>
        <li>Implement it with the <a href="#implement">guide below</a>.</li>
        <li>Write <code>Closes #42</code> in your pull request.</li>
      </ol>
      <ol class="next-steps" data-next-request hidden>
        <li>Maintainers label it so contributors can find it.</li>
        <li>GitHub notifies you when someone picks it up.</li>
      </ol>
    </section>

    <section class="panel path-panel" id="implement" aria-labelledby="implement-heading">
      <div class="path-intro">
        <div>
          <p class="step-label">Step 3 · Implement</p>
          <h2 id="implement-heading">Implementation guide</h2>
          <p>Code and tests only. No results, no raw data.</p>
        </div>
        <div class="segmented" role="group" aria-label="Guide type">
          <button type="button" class="is-active" data-kind-button="model" aria-pressed="true">Model</button>
          <button type="button" data-kind-button="dataset" aria-pressed="false">Dataset</button>
        </div>
      </div>

      <div data-path="model">
        <ol class="code-steps">
          <li>
            <span class="step-number">1</span>
            <div>
              <h3>Add the implementation</h3>
              <p>Fork <span class="repository-placeholder" role="link" aria-disabled="true" title="Repository link withheld during review">[Model repository]</span> and add <code>src/whar_models/&lt;model_id&gt;/</code> with a builder taking <code>input_channels</code>, <code>window_length</code> and <code>num_classes</code>.</p>
            </div>
          </li>
          <li>
            <span class="step-number">2</span>
            <div>
              <h3>Register it</h3>
              <p>Add it to <code>WHARModelID</code> and <code>ModelSpec</code> in <code>registry.py</code>.</p>
            </div>
          </li>
          <li>
            <span class="step-number">3</span>
            <div>
              <h3>Test it</h3>
              <p>Add a forward-pass test for varying channel, window and class counts.</p>
              <div class="command-row">
                <code>uv sync --extra dev</code>
                <code>uv run pytest</code>
              </div>
            </div>
          </li>
          <li>
            <span class="step-number">4</span>
            <div>
              <h3>Open the pull request</h3>
              <p>Link the proposal with <code>Closes #&lt;issue&gt;</code>.</p>
              <span class="inline-link repository-placeholder" role="link" aria-disabled="true">[Pull request link]</span>
            </div>
          </li>
        </ol>
      </div>

      <div data-path="dataset" hidden>
        <ol class="code-steps">
          <li>
            <span class="step-number">1</span>
            <div>
              <h3>Add a parser and config</h3>
              <p>Fork <span class="repository-placeholder" role="link" aria-disabled="true" title="Repository link withheld during review">[Dataset repository]</span> and add <code>config/cfg_&lt;dataset_id&gt;.py</code> with a parser and <code>WHARConfig</code>.</p>
            </div>
          </li>
          <li>
            <span class="step-number">2</span>
            <div>
              <h3>Register it</h3>
              <p>Add the ID to <code>WHARDatasetID</code> in <code>getter.py</code>.</p>
            </div>
          </li>
          <li>
            <span class="step-number">3</span>
            <div>
              <h3>Test it</h3>
              <p>Add parser tests with small synthetic fixtures. Never commit raw data.</p>
              <div class="command-row">
                <code>uv sync --extra dev</code>
                <code>uv run pytest</code>
              </div>
            </div>
          </li>
          <li>
            <span class="step-number">4</span>
            <div>
              <h3>Open the pull request</h3>
              <p>Link the proposal with <code>Closes #&lt;issue&gt;</code>.</p>
              <span class="inline-link repository-placeholder" role="link" aria-disabled="true">[Pull request link]</span>
            </div>
          </li>
        </ol>
      </div>

      <div class="acceptance-note">
        <strong>Step 4 · After merge</strong>
        <span>Maintainers benchmark the entry and publish the results.</span>
      </div>
    </section>
  </BenchmarkPage>
</BaseLayout>

<script>
  type ContributionKind = "model" | "dataset";
  type Intent = "self" | "request";
  type Entry = { id: string; name: string };
  type ExistingEntries = Record<ContributionKind, Entry[]> & { pages: Record<ContributionKind, string> };

  const repositoryLabels: Record<ContributionKind, string> = {
    model: "[Model repository]",
    dataset: "[Dataset repository]",
  };
  const draftKey = "harena-contribute-draft";

  const existing = JSON.parse(
    document.getElementById("existing-entries")?.textContent ?? "{}",
  ) as ExistingEntries;

  // Resolve catalog links relative to this page so the form also works below
  // an anonymous hosting prefix and on the local development server.
  const pageDirectory = new URL(window.location.href);
  pageDirectory.pathname = pageDirectory.pathname.replace(/\/index\.html$/, "/").replace(/\/?$/, "/");

  let activeKind: ContributionKind = "model";
  let currentTitle = "";
  let currentMarkdown = "";

  const kindButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-kind-button]"));
  const paths = Array.from(document.querySelectorAll<HTMLElement>("[data-path]"));
  const forms = Array.from(document.querySelectorAll<HTMLFormElement>("[data-contribution-form]"));
  const intentInputs = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="intent"]'));
  const previewTitle = document.querySelector<HTMLElement>("[data-preview-title]");
  const previewBody = document.querySelector<HTMLElement>("[data-preview-body]");
  const previewRepo = document.querySelector<HTMLElement>("[data-preview-repo]");
  const formStatus = document.querySelector<HTMLElement>("[data-form-status]");
  const nextPanel = document.querySelector<HTMLElement>("[data-next-panel]");
  const nextSelf = document.querySelector<HTMLElement>("[data-next-self]");
  const nextRequest = document.querySelector<HTMLElement>("[data-next-request]");
  const architectureOptions = document.querySelector<HTMLElement>("[data-architecture-options]");
  const customArchitectureInput = document.querySelector<HTMLInputElement>("[data-custom-architecture]");
  const copyButton = document.querySelector<HTMLButtonElement>("[data-copy-markdown]");
  const defaultStatus = formStatus?.innerHTML ?? "";

  const formFor = (kind: ContributionKind) =>
    forms.find((form) => form.dataset.contributionForm === kind) as HTMLFormElement;
  const value = (data: FormData, key: string) => String(data.get(key) ?? "").trim();
  const slugify = (text: string) =>
    text.toLowerCase().normalize("NFKD").replace(/[^a-z0-9]+/g, "_").replace(/^_+|_+$/g, "");
  const currentIntent = (): Intent =>
    intentInputs.find((input) => input.checked)?.value === "request" ? "request" : "self";
  const cell = (text: string) => text.replaceAll("|", "\\|").replaceAll("\n", " ");
  const link = (url: string) => (url ? `<${url}>` : "");

  const entryId = (data: FormData, kind: ContributionKind) =>
    value(data, "id") || slugify(value(data, "name")) || `new_${kind}`;

  const makeIssue = (kind: ContributionKind, data: FormData, intent: Intent) => {
    const name = value(data, "name") || `New ${kind}`;
    const rows: [string, string][] = [
      [kind === "model" ? "Model ID" : "Dataset ID", `\`${entryId(data, kind)}\``],
      ["Name", name],
    ];

    if (kind === "model") {
      const components = data.getAll("architecture_parts").map(String);
      rows.push(
        ["Paper", value(data, "paper_title")],
        ["Paper link", link(value(data, "paper_url"))],
        ["Year", value(data, "year")],
        ["Authors", value(data, "authors")],
        ["Building blocks", components.join(", ")],
        ["Framework", formFor("model").querySelector<HTMLSelectElement>('select[name="framework"]')?.selectedOptions[0]?.text ?? ""],
        ["Original implementation", link(value(data, "source_url"))],
        ["License", value(data, "license")],
      );
    } else {
      const rate = value(data, "sampling_freq");
      rows.push(
        ["Dataset page", link(value(data, "dataset_url"))],
        ["Data access", value(data, "download_url")],
        ["License / terms", value(data, "license")],
        ["Paper link", link(value(data, "paper_url"))],
        ["Year", value(data, "year")],
        ["Authors", value(data, "authors")],
        ["Subjects", value(data, "subjects")],
        ["Activities", value(data, "activities")],
        ["Sampling rate", rate ? `${rate} Hz` : ""],
        ["Sensors / positions", value(data, "sensors")],
        ["Activity labels", value(data, "activity_names")],
        ["Official benchmark", data.get("benchmark_eligible") ? "Inclusion requested" : "Library only"],
      );
    }

    const notes = value(data, "notes");
    const label = kind === "model" ? "Model" : "Dataset";
    const title = `[${label} ${intent === "self" ? "proposal" : "request"}] ${name}`;
    const intentLine = intent === "self"
      ? "**I plan to implement this myself** and will open a pull request that references this issue."
      : "**This is a request.** I am not planning to implement it myself; maintainers or other contributors are welcome to pick it up.";

    const body = [
      intentLine,
      "",
      `## ${label} details`,
      "",
      "| Field | Value |",
      "| --- | --- |",
      ...rows.filter(([, fieldValue]) => fieldValue).map(([key, fieldValue]) => `| ${key} | ${cell(fieldValue)} |`),
      ...(notes ? ["", "## Notes", "", notes] : []),
      "",
      "---",
      `_Prepared with the HARena contribute page. Implementation guide: ${window.location.origin}${window.location.pathname}#implement_`,
    ].join("\n");

    return { title, body };
  };

  const updateDuplicateWarning = (form: HTMLFormElement, kind: ContributionKind) => {
    const warning = form.querySelector<HTMLElement>("[data-duplicate-warning]");
    const name = form.querySelector<HTMLInputElement>("[data-name-input]")?.value.trim() ?? "";
    const id = form.querySelector<HTMLInputElement>("[data-id-input]")?.value.trim() ?? "";
    if (!warning) return;
    const candidates = new Set([slugify(name), slugify(id)].filter((item) => item.length > 1));
    const match = (existing[kind] ?? []).find(
      (entry) => candidates.has(entry.id) || candidates.has(slugify(entry.name)),
    );
    warning.hidden = !match;
    if (match) {
      warning.replaceChildren(
        "HARena already includes ",
        Object.assign(document.createElement("strong"), { textContent: match.name }),
        ` (${match.id}). `,
        Object.assign(document.createElement("a"), {
          href: new URL(existing.pages[kind], pageDirectory).href,
          textContent: `Check the ${kind} list`,
        }),
        " before proposing it again. Variants are welcome; explain the difference in the notes.",
      );
    }
  };

  const updatePreview = () => {
    const form = formFor(activeKind);
    const issue = makeIssue(activeKind, new FormData(form), currentIntent());
    currentTitle = issue.title;
    currentMarkdown = issue.body;
    if (previewTitle) previewTitle.textContent = issue.title;
    if (previewBody) previewBody.textContent = issue.body;
    if (previewRepo) previewRepo.textContent = repositoryLabels[activeKind];
    updateDuplicateWarning(form, activeKind);
  };

  const formValues = (kind: ContributionKind) => {
    const data = new FormData(formFor(kind));
    return Object.fromEntries(Array.from(data.keys(), (key) => [key, data.getAll(key).map(String)]));
  };

  const saveDraft = () => {
    try {
      const draft = { kind: activeKind, intent: currentIntent(), model: formValues("model"), dataset: formValues("dataset") };
      localStorage.setItem(draftKey, JSON.stringify(draft));
    } catch {
      // Drafts are a convenience only.
    }
  };

  const restoreDraft = () => {
    let draft: { kind?: ContributionKind; intent?: Intent; model?: Record<string, string[]>; dataset?: Record<string, string[]> } | null = null;
    try {
      draft = JSON.parse(localStorage.getItem(draftKey) ?? "null");
    } catch {
      draft = null;
    }
    if (!draft) return;
    (["model", "dataset"] as const).forEach((kind) => {
      const values = draft?.[kind];
      if (!values) return;
      const form = formFor(kind);
      (values.architecture_parts ?? []).forEach((part) => addArchitecture(part));
      form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("[name]").forEach((field) => {
        const stored = values[field.name];
        if (field instanceof HTMLInputElement && field.type === "checkbox") {
          field.checked = (stored ?? []).includes(field.value);
        } else if (stored?.[0] !== undefined) {
          field.value = stored[0];
          if (field.matches("[data-id-input]") && stored[0]) field.dataset.touched = "true";
        }
      });
    });
    intentInputs.forEach((input) => (input.checked = input.value === (draft?.intent ?? "self")));
    if (draft.kind === "dataset") setActiveKind("dataset");
  };

  function addArchitecture(labelText: string) {
    if (!labelText || !architectureOptions) return;
    const existingOption = Array.from(
      architectureOptions.querySelectorAll<HTMLInputElement>('input[name="architecture_parts"]'),
    ).find((input) => input.value.toLowerCase() === labelText.toLowerCase());
    if (existingOption) {
      existingOption.checked = true;
      return;
    }
    const label = document.createElement("label");
    label.className = "is-custom";
    const input = document.createElement("input");
    input.type = "checkbox";
    input.name = "architecture_parts";
    input.value = labelText;
    input.checked = true;
    const text = document.createElement("span");
    text.textContent = labelText;
    label.append(input, text);
    architectureOptions.append(label);
  }

  const addCustomArchitecture = () => {
    const labelText = customArchitectureInput?.value.trim() ?? "";
    if (!labelText || !customArchitectureInput) return;
    addArchitecture(labelText);
    customArchitectureInput.value = "";
    customArchitectureInput.setCustomValidity("");
    updatePreview();
    saveDraft();
  };

  function setActiveKind(kind: ContributionKind) {
    activeKind = kind;
    kindButtons.forEach((button) => {
      const isActive = button.dataset.kindButton === kind;
      button.classList.toggle("is-active", isActive);
      button.setAttribute("aria-pressed", String(isActive));
    });
    paths.forEach((path) => (path.hidden = path.dataset.path !== kind));
    forms.forEach((form) => (form.hidden = form.dataset.contributionForm !== kind));
    if (nextPanel) nextPanel.hidden = true;
    updatePreview();
  }

  const validate = (form: HTMLFormElement) => {
    if (activeKind === "model") {
      addCustomArchitecture();
      const selected = form.querySelectorAll('input[name="architecture_parts"]:checked');
      if (selected.length === 0 && customArchitectureInput) {
        customArchitectureInput.setCustomValidity("Select at least one building block, or type your own.");
        customArchitectureInput.reportValidity();
        return false;
      }
    }
    return form.reportValidity();
  };

  const copyText = async (text: string): Promise<"copied" | "selected" | "failed"> => {
    try {
      await navigator.clipboard.writeText(text);
      return "copied";
    } catch {
      // Anonymous hosting can restrict clipboard access. Keep the draft easy
      // to copy manually without sending it anywhere.
      const selection = window.getSelection();
      if (!selection || !previewTitle || !previewBody) return "failed";
      const range = document.createRange();
      range.setStartBefore(previewTitle);
      range.setEndAfter(previewBody);
      selection.removeAllRanges();
      selection.addRange(range);
      return "selected";
    }
  };

  kindButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const kind = button.dataset.kindButton;
      if (kind === "model" || kind === "dataset") {
        setActiveKind(kind);
        saveDraft();
      }
    });
  });

  intentInputs.forEach((input) => input.addEventListener("change", () => {
    updatePreview();
    saveDraft();
  }));

  forms.forEach((form) => {
    const nameInput = form.querySelector<HTMLInputElement>("[data-name-input]");
    const idInput = form.querySelector<HTMLInputElement>("[data-id-input]");
    nameInput?.addEventListener("input", () => {
      if (idInput && !idInput.dataset.touched) idInput.value = slugify(nameInput.value);
    });
    idInput?.addEventListener("input", () => {
      idInput.dataset.touched = idInput.value ? "true" : "";
    });
    form.addEventListener("input", () => {
      updatePreview();
      saveDraft();
    });
    form.addEventListener("change", () => {
      customArchitectureInput?.setCustomValidity("");
      updatePreview();
      saveDraft();
    });
    form.addEventListener("submit", (event) => event.preventDefault());
  });

  document.querySelector("[data-add-architecture]")?.addEventListener("click", addCustomArchitecture);
  customArchitectureInput?.addEventListener("keydown", (event) => {
    if (event.key === "Enter") {
      event.preventDefault();
      addCustomArchitecture();
    }
  });

  document.querySelector("[data-open-issue]")?.addEventListener("click", () => {
    const form = formFor(activeKind);
    if (!validate(form)) return;
    updatePreview();

    const intent = currentIntent();
    if (nextSelf) nextSelf.hidden = intent !== "self";
    if (nextRequest) nextRequest.hidden = intent !== "request";
    if (nextPanel) {
      nextPanel.hidden = false;
      nextPanel.scrollIntoView({ behavior: "smooth", block: "start" });
      nextPanel.focus({ preventScroll: true });
    }
  });

  copyButton?.addEventListener("click", async () => {
    updatePreview();
    const copied = await copyText(`${currentTitle}\n\n${currentMarkdown}`);
    copyButton.textContent = copied === "copied" ? "Copied" : copied === "selected" ? "Text selected" : "Copy failed";
    window.setTimeout(() => (copyButton.textContent = "Copy text"), 1600);
  });

  document.querySelector("[data-reset-form]")?.addEventListener("click", () => {
    forms.forEach((form) => {
      form.reset();
      form.querySelectorAll<HTMLInputElement>("[data-id-input]").forEach((input) => (input.dataset.touched = ""));
    });
    architectureOptions?.querySelectorAll(".is-custom").forEach((label) => label.remove());
    try {
      localStorage.removeItem(draftKey);
    } catch {
      // Ignore unavailable storage.
    }
    if (nextPanel) nextPanel.hidden = true;
    if (formStatus) formStatus.innerHTML = defaultStatus;
    updatePreview();
  });

  restoreDraft();
  updatePreview();
</script>

